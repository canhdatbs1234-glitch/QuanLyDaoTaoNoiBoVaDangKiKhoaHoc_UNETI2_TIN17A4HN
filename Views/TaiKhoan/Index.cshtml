@*
//Họ và tên: Nguyễn Cảnh Đạt
//Mã sinh viên: 23103100224
//Module 1: Tài khoản – Đăng nhập – Phân quyền – Phòng ban – Lĩnh vực đào tạo.
*@
@model IReadOnlyList<QuanLyDaoTaoNoiBo.Models.Entities.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var currentRole = Context.Session.GetString("VaiTro");
    var vaiTroLoc = (string?)ViewData["VaiTro"];
    var trangThaiLoc = (string?)ViewData["TrangThai"];
}
<div class="section-heading"><div><p class="eyebrow navy">Hệ thống</p><h1>Quản lý tài khoản</h1><p class="muted">@Model.Count tài khoản</p></div><a class="primary-button" asp-action="Create">+ Thêm tài khoản</a></div>
<partial name="_ThongBao" />
<form asp-action="Index" method="get" class="filter-panel"><div class="filter-grid">
<div class="field"><label for="tuKhoa">Từ khóa</label><input id="tuKhoa" name="tuKhoa" value="@ViewData["TuKhoa"]" placeholder="Tên đăng nhập, họ tên hoặc email" /></div>
<div class="field"><label for="vaiTro">Vai trò</label><select id="vaiTro" name="vaiTro"><option value="">Tất cả</option>
@foreach (var r in VaiTroTaiKhoan.TatCa)
{
    <option value="@r" selected="@(vaiTroLoc == r)">@VaiTroTaiKhoan.Ten(r)</option>
}
</select></div>
<div class="field"><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai"><option value="">Tất cả</option><option value="hoatdong" selected="@(trangThaiLoc == "hoatdong")">Hoạt động</option><option value="khoa" selected="@(trangThaiLoc == "khoa")">Bị khóa</option></select></div>
</div><div class="actions"><button class="primary-button" type="submit">Tìm kiếm</button><a class="secondary-button" asp-action="Index">Xóa lọc</a></div></form>
<div class="table-panel"><table class="data-table"><thead><tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var duocQuanLy = !(currentRole == VaiTroTaiKhoan.QuanLy && item.VaiTro == VaiTroTaiKhoan.QuanTri);
<tr>
    <td>@if (duocQuanLy) { <a asp-action="Details" asp-route-id="@item.MaTaiKhoan">@item.TenDangNhap</a> } else { <text>@item.TenDangNhap</text> }</td>
    <td>@item.HoTen</td><td>@item.Email</td>
    <td><span class="role-badge">@VaiTroTaiKhoan.Ten(item.VaiTro)</span></td>
    <td><span class="status-badge @(item.TrangThai ? "status-on" : "status-off")">@(item.TrangThai ? "Hoạt động" : "Bị khóa")</span></td>
    <td class="row-actions">@if (duocQuanLy) { <a asp-action="Edit" asp-route-id="@item.MaTaiKhoan">Sửa</a><a asp-action="Details" asp-route-id="@item.MaTaiKhoan">Chi tiết</a> } else { <span class="muted">Chỉ Quản trị</span> }</td>
</tr>
}
@if (Model.Count == 0) { <tr><td colspan="6" class="table-empty">Không có tài khoản phù hợp.</td></tr> }
</tbody></table></div>
