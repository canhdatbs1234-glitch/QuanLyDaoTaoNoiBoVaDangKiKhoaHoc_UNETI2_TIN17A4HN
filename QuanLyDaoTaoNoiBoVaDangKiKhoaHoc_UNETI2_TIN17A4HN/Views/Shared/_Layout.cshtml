@*
*@
@{
    var loggedIn = Context.Session.GetInt32("MaTaiKhoan").HasValue;
    var role = Context.Session.GetString("VaiTro");
    var roleName = role switch { "QuanTri" => "Quản trị viên", "QuanLy" => "Nhân sự - Đào tạo", "GiangVien" => "Giảng viên", _ => "Nhân viên" };
    var management = role is "QuanTri" or "QuanLy";
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var module = ViewContext.RouteData.Values["id"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Đào tạo nội bộ UNETI</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/module5.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>
    <div class="utility-bar"><span>TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP</span><span>Tri thức • Kỹ năng • Phát triển</span></div>
    <header class="portal-header">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/uneti-mark.svg" alt="Biểu trưng chữ UNETI" width="70" height="70" />
            <span><small>UNETI · INTERNAL LEARNING</small><strong>CỔNG THÔNG TIN<br />ĐÀO TẠO NỘI BỘ UNETI</strong></span>
        </a>
        @if (loggedIn)
        {
            <div class="user-area">
                <div><strong>@Context.Session.GetString("HoTen")</strong><span class="role-badge">@roleName</span></div>
                <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post"><button class="logout-button" type="submit">Đăng xuất ↗</button></form>
            </div>
        }
        else
        {
            <span class="header-caption">CỔNG DÀNH CHO CÁN BỘ & NHÂN VIÊN</span>
        }
    </header>
    <div class="accent-strip"></div>
    <div class="@(loggedIn ? "portal-shell" : "guest-shell")">
        @if (loggedIn)
        {
            <aside class="sidebar">
                <p class="nav-label">KHÔNG GIAN ĐÀO TẠO</p>
                <nav aria-label="Menu chính">
                    <a class="@(controller == "Dashboard" || (controller == "Home" && action is ("QuanTri" or "QuanLy" or "NhanVien" or "Index")) ? "active" : "")" asp-controller="@(management ? "Dashboard" : "Home")" asp-action="Index"><span aria-hidden="true">▦</span> @(management ? "Dashboard / Thống kê" : "Trang cá nhân")</a>
                    @if (management)
                    {
                        <a class="@(controller == "TaiKhoan" ? "active" : "")" asp-controller="TaiKhoan" asp-action="Index"><span aria-hidden="true">♙</span> Tài khoản</a>
                        <a class="@(controller == "PhongBan" ? "active" : "")" asp-controller="PhongBan" asp-action="Index"><span aria-hidden="true">▤</span> Phòng ban</a>
                        <a class="@(controller == "LinhVucDaoTao" ? "active" : "")" asp-controller="LinhVucDaoTao" asp-action="Index"><span aria-hidden="true">▤</span> Lĩnh vực đào tạo</a>
                        <a class="@(controller == "KhoaDaoTao" ? "active" : "")" asp-controller="KhoaDaoTao" asp-action="Index"><span aria-hidden="true">▤</span> Khóa đào tạo</a>
                        <a class="@(controller == "LopDaoTao" ? "active" : "")" asp-controller="LopDaoTao" asp-action="Index"><span aria-hidden="true">▦</span> Lớp đào tạo</a>
                        <a class="@(controller == "NhanVien" ? "active" : "")" asp-controller="NhanVien" asp-action="Index"><span aria-hidden="true">♙</span> Quản lý Nhân viên</a>
                        <a class="@(controller == "DangKyDaoTao" && action == "DuyetDangKy" ? "active" : "")" asp-controller="DangKyDaoTao" asp-action="DuyetDangKy"><span aria-hidden="true">✓</span> Duyệt đăng ký</a>
                        <a class="@(controller == "BuoiHoc" || (controller == "DiemDanh" && action == "DiemDanhBuoiHoc") ? "active" : "")" asp-controller="BuoiHoc" asp-action="Index"><span aria-hidden="true">▦</span> Buổi học / Điểm danh</a>
                        <a class="@(controller == "KetQuaDaoTao" && action == "DanhGia" ? "active" : "")" asp-controller="KetQuaDaoTao" asp-action="DanhGia"><span aria-hidden="true">✓</span> Đánh giá kết quả</a>
                    }
                    @if (role == "NhanVien")
                    {
                        <a class="@(controller == "DangKyDaoTao" && action == "Index" ? "active" : "")" asp-controller="DangKyDaoTao" asp-action="Index"><span aria-hidden="true">⊕</span> Đăng ký đào tạo</a>
                        <a class="@(controller == "DangKyDaoTao" && action == "LichSuDangKy" ? "active" : "")" asp-controller="DangKyDaoTao" asp-action="LichSuDangKy"><span aria-hidden="true">◷</span> Lịch sử đăng ký</a>
                        <a class="@(controller == "BuoiHoc" ? "active" : "")" asp-controller="BuoiHoc" asp-action="LichHoc"><span aria-hidden="true">▦</span> Lịch học của tôi</a>
                    }
                    <a class="@(controller == "DiemDanh" && action == "ThongKeThamGia" ? "active" : "")" asp-controller="DiemDanh" asp-action="ThongKeThamGia"><span aria-hidden="true">◷</span> Theo dõi tham gia</a>
                    <a class="@(controller == "KetQuaDaoTao" && action == "LichSuDaoTao" ? "active" : "")" asp-controller="KetQuaDaoTao" asp-action="LichSuDaoTao"><span aria-hidden="true">◷</span> Lịch sử đào tạo</a>
                </nav>
                <div class="sidebar-note"><strong>Học tập suốt đời</strong><p>Mỗi khóa học là một bước tiến trong hành trình phát triển.</p></div>
            </aside>
        }
        <main id="main-content" class="@(loggedIn ? "main-content" : "login-main")">@RenderBody()</main>
    </div>
    <footer>© Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI) - Hệ thống Quản lý Đào tạo Nội bộ</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
