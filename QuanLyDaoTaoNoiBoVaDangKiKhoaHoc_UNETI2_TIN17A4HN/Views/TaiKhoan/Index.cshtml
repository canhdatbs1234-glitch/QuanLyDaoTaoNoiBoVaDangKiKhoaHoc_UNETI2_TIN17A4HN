@functions { public string TenVaiTro(string? role) => role switch { "QuanTri" => "Admin / Nhân sự - Đào tạo", "GiangVien" => "Giảng viên", "NhanVien" => "Nhân viên", _ => "Không xác định" }; }
@* Module 1: Quản lý tài khoản – đăng nhập – phân quyền. *@
@model IReadOnlyList<QuanLyDaoTaoNoiBo.Models.Entities.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var vaiTroLoc = (string?)ViewData["VaiTro"];
    var trangThaiLoc = (string?)ViewData["TrangThai"];
    var tuKhoaLoc = (string?)ViewData["TuKhoa"];
}
<div class="section-heading"><div><p class="eyebrow navy">Hệ thống</p><h1>Quản lý tài khoản</h1><p class="muted">@ViewData["TotalCount"] tài khoản</p></div><a class="primary-button" asp-action="Create">+ Thêm tài khoản</a></div>
<partial name="_ThongBao" />
<form asp-action="Index" method="get" class="filter-panel"><div class="filter-grid">
    <div class="field"><label for="tuKhoa">Từ khóa</label><input id="tuKhoa" name="tuKhoa" value="@tuKhoaLoc" placeholder="Tên đăng nhập, họ tên hoặc email" /></div>
    <div class="field"><label for="vaiTro">Vai trò</label><select id="vaiTro" name="vaiTro"><option value="">Tất cả</option>
    @foreach (var r in new[] { "QuanTri", "NhanVien", "GiangVien" }) { <option value="@r" selected="@(vaiTroLoc == r)">@TenVaiTro(r)</option> }
    </select></div>
    <div class="field"><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai"><option value="">Tất cả</option><option value="hoatdong" selected="@(trangThaiLoc == "hoatdong")">Hoạt động</option><option value="khoa" selected="@(trangThaiLoc == "khoa")">Bị khóa</option></select></div>
    <input type="hidden" name="sort" value="@ViewData["Sort"]" />
</div><div class="actions"><button class="primary-button" type="submit">Tìm kiếm</button><a class="secondary-button" asp-action="Index">Xóa lọc</a></div></form>
<div class="table-panel"><table class="data-table"><thead><tr>
<th><button type="button" class="sort-trigger" popovertarget="sort-username">Tên đăng nhập <span aria-hidden="true">↕</span></button>
<div id="sort-username" class="sort-popover" popover="auto" role="menu">
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="tenDangNhap_az" asp-route-page="1">A → Z</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="tenDangNhap_za" asp-route-page="1">Z → A</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="tenDangNhap_short" asp-route-page="1">Ngắn → dài</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="tenDangNhap_long" asp-route-page="1">Dài → ngắn</a>
</div></th>
<th><button type="button" class="sort-trigger" popovertarget="sort-hoten">Họ tên <span aria-hidden="true">↕</span></button>
<div id="sort-hoten" class="sort-popover" popover="auto" role="menu">
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="hoTen_az" asp-route-page="1">A → Z</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="hoTen_za" asp-route-page="1">Z → A</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="hoTen_short" asp-route-page="1">Tên ngắn trước</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="hoTen_long" asp-route-page="1">Tên dài trước</a>
</div></th>
<th><button type="button" class="sort-trigger" popovertarget="sort-email">Email <span aria-hidden="true">↕</span></button>
<div id="sort-email" class="sort-popover" popover="auto" role="menu">
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="email_az" asp-route-page="1">A → Z</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="email_za" asp-route-page="1">Z → A</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="email_short" asp-route-page="1">Email ngắn trước</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="email_long" asp-route-page="1">Email dài trước</a>
</div></th>
<th><button type="button" class="sort-trigger" popovertarget="sort-role">Vai trò <span aria-hidden="true">↕</span></button>
<div id="sort-role" class="sort-popover" popover="auto" role="menu">
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="vaiTro_az" asp-route-page="1">A → Z theo tên vai trò</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="vaiTro_za" asp-route-page="1">Z → A theo tên vai trò</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="vaiTro_quanTriFirst" asp-route-page="1">Admin / Nhân sự trước</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="vaiTro_giangVienFirst" asp-route-page="1">Giảng viên trước</a>
</div></th>
<th><button type="button" class="sort-trigger" popovertarget="sort-account-status">Trạng thái <span aria-hidden="true">↕</span></button>
<div id="sort-account-status" class="sort-popover" popover="auto" role="menu">
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="trangThai_az" asp-route-page="1">A → Z theo nhãn</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="trangThai_za" asp-route-page="1">Z → A theo nhãn</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="trangThai_hoatDongFirst" asp-route-page="1">Hoạt động trước</a>
    <a role="menuitem" asp-action="Index" asp-route-tuKhoa="@tuKhoaLoc" asp-route-vaiTro="@vaiTroLoc" asp-route-trangThai="@trangThaiLoc" asp-route-sort="trangThai_khoaFirst" asp-route-page="1">Bị khóa trước</a>
</div></th>
<th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr>
        <td><a asp-action="Details" asp-route-id="@item.MaTaiKhoan">@item.TenDangNhap</a></td>
        <td>@item.HoTen</td><td>@item.Email</td>
        <td><span class="role-badge">@TenVaiTro(item.VaiTro)</span></td>
        <td><span class="status-badge @(item.TrangThai ? "status-on" : "status-off")">@(item.TrangThai ? "Hoạt động" : "Bị khóa")</span></td>
        <td class="row-actions"><a asp-action="Edit" asp-route-id="@item.MaTaiKhoan">Sửa</a><a asp-action="Details" asp-route-id="@item.MaTaiKhoan">Chi tiết</a></td>
    </tr>
}
@if (Model.Count == 0) { <tr><td colspan="6" class="table-empty">Không có tài khoản phù hợp.</td></tr> }
</tbody></table></div>
@{
    var currentPage = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var startRecord = totalCount == 0 ? 0 : (currentPage - 1) * 10 + 1;
    var endRecord = Math.Min(currentPage * 10, totalCount);
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
}
<div class="pagination-summary">Hiển thị <strong>@startRecord–@endRecord</strong> trên <strong>@totalCount</strong> dữ liệu · 10 dữ liệu/trang</div>
<nav class="pagination" aria-label="Phân trang">
    @if (currentPage > 1)
    {
        <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-sort="@ViewData["Sort"]" asp-route-tuKhoa="@ViewData["TuKhoa"]" asp-route-vaiTro="@ViewData["VaiTro"]" asp-route-trangThai="@ViewData["TrangThai"]">‹ Trước</a>
    }
    else { <span class="page-disabled">‹ Trước</span> }
    @if (startPage > 1) { <a asp-action="Index" asp-route-page="1" asp-route-sort="@ViewData["Sort"]" asp-route-tuKhoa="@ViewData["TuKhoa"]" asp-route-vaiTro="@ViewData["VaiTro"]" asp-route-trangThai="@ViewData["TrangThai"]">1</a><span class="page-ellipsis">…</span> }
    @for (var p = startPage; p <= endPage; p++)
    {
        if (p == currentPage) { <span class="current" aria-current="page">@p</span> }
        else { <a asp-action="Index" asp-route-page="@p" asp-route-sort="@ViewData["Sort"]" asp-route-tuKhoa="@ViewData["TuKhoa"]" asp-route-vaiTro="@ViewData["VaiTro"]" asp-route-trangThai="@ViewData["TrangThai"]">@p</a> }
    }
    @if (endPage < totalPages) { <span class="page-ellipsis">…</span><a asp-action="Index" asp-route-page="@totalPages" asp-route-sort="@ViewData["Sort"]" asp-route-tuKhoa="@ViewData["TuKhoa"]" asp-route-vaiTro="@ViewData["VaiTro"]" asp-route-trangThai="@ViewData["TrangThai"]">@totalPages</a> }
    @if (currentPage < totalPages)
    {
        <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-sort="@ViewData["Sort"]" asp-route-tuKhoa="@ViewData["TuKhoa"]" asp-route-vaiTro="@ViewData["VaiTro"]" asp-route-trangThai="@ViewData["TrangThai"]">Sau ›</a>
    }
    else { <span class="page-disabled">Sau ›</span> }
</nav>
