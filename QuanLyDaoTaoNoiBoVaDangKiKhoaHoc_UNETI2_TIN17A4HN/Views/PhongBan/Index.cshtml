@*
//Họ và tên: Nguyễn Cảnh Đạt
//Mã sinh viên: 23103100224
//Module 1: Tài khoản – Đăng nhập – Phân quyền – Phòng ban – Lĩnh vực đào tạo.
*@
@model IReadOnlyList<QuanLyDaoTaoNoiBo.Models.Entities.PhongBan>
@{ ViewData["Title"] = "Quản lý phòng ban"; }
<div class="section-heading"><div><p class="eyebrow navy">Nhân viên</p><h1>Quản lý phòng ban</h1><p class="muted">@Model.Count phòng ban</p></div><a class="primary-button" asp-action="Create">+ Thêm phòng ban</a></div>
<partial name="_Module2Messages" />
<form asp-action="Index" method="get" class="filter-panel"><div class="filter-grid">
<div class="field"><label for="tuKhoa">Từ khóa</label><input id="tuKhoa" name="tuKhoa" value="@ViewData["TuKhoa"]" placeholder="Tên hoặc mô tả" /></div>
<div class="field"><label for="trangThai">Trạng thái</label><select id="trangThai" name="trangThai"><option value="">Tất cả</option><option value="hoatdong" selected="@((string?)ViewData["TrangThai"] == "hoatdong")">Hoạt động</option><option value="ngung" selected="@((string?)ViewData["TrangThai"] == "ngung")">Ngừng hoạt động</option></select></div>
</div><div class="actions"><button class="primary-button" type="submit">Tìm kiếm</button><a class="secondary-button" asp-action="Index">Xóa lọc</a></div></form>
<div class="table-panel"><table class="data-table"><thead><tr><th>Tên phòng ban</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td><a asp-action="Details" asp-route-id="@item.MaPhongBan">@item.TenPhongBan</a></td><td>@item.MoTa</td><td><span class="role-badge">@(item.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</span></td><td class="row-actions"><a asp-action="Edit" asp-route-id="@item.MaPhongBan">Sửa</a><a asp-action="Details" asp-route-id="@item.MaPhongBan">Chi tiết / Xóa</a></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="4" class="table-empty">Không có phòng ban phù hợp.</td></tr> }
</tbody></table></div>
