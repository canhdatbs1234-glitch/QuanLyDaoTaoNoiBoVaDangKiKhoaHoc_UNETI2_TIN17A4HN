@*
// Họ và tên: Đàm Quang Huy
// Mã sinh viên: 23103100197
// Nội dung thực hiện: Module 5 - Danh sách kết quả đào tạo (tìm kiếm, lọc, sắp xếp, phân trang).
*@
@model KetQuaDaoTaoListViewModel
@{
    ViewData["Title"] = "Kết quả đào tạo";
}
<div class="section-heading"><div>
    <p class="eyebrow navy">ĐÀO TẠO / KẾT QUẢ</p>
    <h1>Kết quả đào tạo</h1>
    <p class="muted">Đánh giá học viên đã được duyệt. Tỷ lệ tham dự và kết quả do hệ thống tính, không nhập tay.</p>
</div></div>
<partial name="_ThongBao" />

<form asp-action="Index" method="get" class="filter-panel">
    <div class="search-row">
        <div class="field search-field"><label asp-for="SearchTerm">Tìm kiếm</label><input asp-for="SearchTerm" placeholder="Tên học viên hoặc tên lớp" /></div>
        <div class="actions"><button type="submit" class="primary-button">Tìm kiếm</button></div>
    </div>
    <div class="filter-grid">
        <div class="field"><label asp-for="MaLop">Lớp đào tạo</label><select asp-for="MaLop" asp-items="Model.Lops"><option value="">Tất cả lớp</option></select></div>
        <div class="field"><label asp-for="MaPhongBan">Phòng ban</label><select asp-for="MaPhongBan" asp-items="Model.PhongBans"><option value="">Tất cả phòng ban</option></select></div>
        <div class="field"><label asp-for="TrangThaiKetQua">Kết quả</label>
            <select asp-for="TrangThaiKetQua">
                <option value="">Tất cả</option>
                <option value="chua">Chưa đánh giá</option>
                <option value="Dat">Hoàn thành</option>
                <option value="KhongDat">Không hoàn thành</option>
            </select></div>
        <div class="field"><label asp-for="XacNhan">Xác nhận</label>
            <select asp-for="XacNhan">
                <option value="">Tất cả</option>
                <option value="da">Đã xác nhận</option>
                <option value="chua">Chưa xác nhận</option>
            </select></div>
        <div class="field"><label asp-for="SortOrder">Sắp xếp</label>
            <select asp-for="SortOrder">
                @foreach (var option in KetQuaDaoTaoListViewModel.SortOptions)
                {
                    <option value="@option.Key">@option.Value</option>
                }
            </select></div>
    </div>
    <div class="actions"><button type="submit" class="primary-button">Lọc</button><a class="secondary-button" asp-action="Index">Xóa tìm kiếm và bộ lọc</a></div>
</form>

<p class="muted">@Model.TotalCount kết quả · @(Model.TotalPages == 0 ? "Chưa có trang" : $"Trang {Model.PageIndex}/{Model.TotalPages}") · @Model.PageSize dòng/trang</p>
<div class="table-panel">
    <table class="data-table">
        <thead><tr><th>Học viên / Phòng ban</th><th>Lớp</th><th>Tỷ lệ tham dự</th><th>Điểm</th><th>Kết quả</th><th>Xác nhận</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.HoTen<small>@item.TenPhongBan</small></td>
                <td>@item.TenLop</td>
                <td>@(item.TyLeThamDu.HasValue ? item.TyLeThamDu.Value.ToString("0.##") + "%" : "—")</td>
                <td>@(item.DiemDanhGia.HasValue ? item.DiemDanhGia.Value.ToString("0.##") : "—")</td>
                <td><span class="status-badge @item.KetQuaCss">@item.TenKetQua</span></td>
                <td>@if (item.DaXacNhan) { <span class="status-badge status-on">Đã xác nhận</span> } else { <span class="status-badge status-muted">Chưa</span> }</td>
                <td class="row-actions">
                    @if (item.DuDieuKienDanhGia)
                    {
                        <a asp-action="DanhGia" asp-route-maDangKy="@item.MaDangKy">@(item.DaXacNhan ? "Xem / Điều chỉnh" : "Đánh giá")</a>
                    }
                    else
                    {
                        <small>Lớp chưa kết thúc</small>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="7" class="table-empty">Không có học viên phù hợp. Hãy thử thay đổi bộ lọc.</td></tr>
        }
        </tbody>
    </table>
</div>
@if (Model.TotalPages > 1)
{
    <nav class="pagination" aria-label="Phân trang kết quả đào tạo">
        @if (Model.HasPreviousPage)
        {
            <a asp-action="Index" asp-all-route-data="Model.RouteForPage(1)">Đầu</a><a asp-action="Index" asp-all-route-data="Model.RouteForPage(Model.PageIndex - 1)">← Trước</a>
        }
        @for (var page = Math.Max(1, Model.PageIndex - 2); page <= Math.Min(Model.TotalPages, Model.PageIndex + 2); page++)
        {
            if (page == Model.PageIndex) { <span class="current" aria-current="page">@(page)</span> }
            else { <a asp-action="Index" asp-all-route-data="Model.RouteForPage(page)">@(page)</a> }
        }
        @if (Model.HasNextPage)
        {
            <a asp-action="Index" asp-all-route-data="Model.RouteForPage(Model.PageIndex + 1)">Sau →</a><a asp-action="Index" asp-all-route-data="Model.RouteForPage(Model.TotalPages)">Cuối</a>
        }
    </nav>
}