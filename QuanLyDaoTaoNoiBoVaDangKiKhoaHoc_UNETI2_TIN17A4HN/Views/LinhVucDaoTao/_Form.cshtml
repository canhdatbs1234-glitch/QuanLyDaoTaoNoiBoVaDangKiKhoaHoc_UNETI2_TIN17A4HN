@model LinhVucDaoTaoViewModel
<div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<input type="hidden" asp-for="MaLinhVuc" />
<div class="form-grid">
<div class="field"><label asp-for="TenLinhVuc"></label><input asp-for="TenLinhVuc" maxlength="150" /><span asp-validation-for="TenLinhVuc" class="field-error"></span></div>
<div class="field"><label asp-for="MoTa"></label><textarea asp-for="MoTa" rows="3" maxlength="1000"></textarea><span asp-validation-for="MoTa" class="field-error"></span></div>
<div class="field"><label asp-for="TrangThai"></label><input asp-for="TrangThai" /><span asp-validation-for="TrangThai" class="field-error"></span></div>
</div>
<p class="muted">Tên lĩnh vực là bắt buộc và không được trùng. Lĩnh vực dùng để phân loại khóa đào tạo và hỗ trợ tìm kiếm/lọc.</p>
<div class="actions"><button class="primary-button" type="submit">Lưu lĩnh vực</button><a class="secondary-button" asp-action="Index">Quay lại</a></div>
