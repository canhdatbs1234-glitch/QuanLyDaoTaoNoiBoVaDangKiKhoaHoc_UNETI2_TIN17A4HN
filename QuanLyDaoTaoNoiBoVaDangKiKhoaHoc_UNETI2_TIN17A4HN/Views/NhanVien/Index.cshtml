1@*
// Họ và tên: Phí Bảo Nam
// Mã sinh viên: 23103100236
// Nội dung thực hiện: Module 3 - Nhân viên, Đăng ký và Duyệt đào tạo
*@
@model IReadOnlyList<QuanLyDaoTaoNoiBo.Models.Entities.NhanVien>
@{ ViewData["Title"] = "Quản lý nhân viên"; }
<div class="section-heading"><div><p class="eyebrow navy">NHÂN SỰ / HỒ SƠ</p><h1>Quản lý nhân viên</h1><p class="muted">@Model.Count nhân viên</p></div><a class="primary-button" asp-action="Create">+ Thêm nhân viên</a></div>
<partial name="_Module2Messages" />
<div class="table-panel"><table class="data-table"><thead><tr><th>Họ tên</th><th>Tài khoản</th><th>Phòng ban</th><th>Liên hệ</th><th>Ngày vào làm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
<tr><td><a asp-action="Details" asp-route-id="@item.MaNhanVien">@item.HoTen</a></td><td>@item.TaiKhoan.TenDangNhap</td><td>@item.PhongBan.TenPhongBan</td><td>@item.Email<small>@item.SoDienThoai</small></td><td>@item.NgayVaoLam.ToString("dd/MM/yyyy")</td><td>@(item.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</td><td class="row-actions"><a asp-action="Edit" asp-route-id="@item.MaNhanVien">Sửa</a><a asp-action="Details" asp-route-id="@item.MaNhanVien">Chi tiết / Xóa</a></td></tr>
}
@if (Model.Count == 0) { <tr><td colspan="7" class="table-empty">Chưa có nhân viên.</td></tr> }
</tbody></table></div>

