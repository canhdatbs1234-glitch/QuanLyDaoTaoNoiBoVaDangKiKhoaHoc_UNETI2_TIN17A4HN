@model NhanVienViewModel
@{
    ViewData["Title"] = "Thêm hồ sơ nhân viên";
}

<p class="eyebrow navy">QUẢN LÝ NHÂN SỰ / NHÂN VIÊN</p>
<h1>Tạo mới hồ sơ nhân viên</h1>
<p class="muted">Tạo thông tin hồ sơ và liên kết với tài khoản người dùng trong hệ thống.</p>

<partial name="_ThongBao" />

<form asp-action="Create" method="post" class="editor-panel">
    <partial name="_Form" model="Model" />

    <div class="actions">
        <button type="submit" class="primary-button">Lưu hồ sơ</button>
        <a class="secondary-button" asp-action="Index">Quay lại danh sách</a>
    </div>
</form>

@section Scripts {
    @* Dự án không có Views/Shared/_ValidationScriptsPartial.cshtml nên nạp trực tiếp các script validation. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}
